load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "blog-site_lib",
    srcs = [
        "content.go",
        "main.go",
        "models.go",
        "projects.go",
        "render.go",
    ],
    embedsrcs = [
        "assets/blog.css",
        "content/home.md",
        "content/terminal-aesthetic.md",
        "content/why-static.md",
        "templates/error.html",
        "templates/home.html",
        "templates/list.html",
        "templates/partials.html",
        "templates/post.html",
    ],
    importpath = "github.com/candacelabs/candace/blog-site",
    visibility = ["//visibility:private"],
    deps = [
        "@com_github_alecthomas_chroma_v2//formatters/html",
        "@com_github_alecthomas_chroma_v2//styles",
        "@com_github_yuin_goldmark//:goldmark",
        "@com_github_yuin_goldmark//extension",
        "@com_github_yuin_goldmark//parser",
        "@com_github_yuin_goldmark_highlighting_v2//:goldmark-highlighting",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)

go_binary(
    name = "blog-site",
    embed = [":blog-site_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "blog-site_test",
    srcs = [
        "content_test.go",
        "projects_test.go",
        "render_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":blog-site_lib"],
)

# Consuming candace as a Bazel module — the recommended shape.
#
# `bazel_dep` names the module, and `archive_override` says where this build
# gets it from and pins the exact bytes with Subresource Integrity. Because
# candace is a real module here, its own MODULE.bazel supplies its whole
# dependency closure: this file declares only what *this* repository's targets
# use directly.
#
# The placeholders are filled in by tools/test_candace_external_consumer.sh in
# the monorepo. A real consumer substitutes the `integrity`, `strip_prefix`, and
# release URL that tools/package_candace_archive.sh printed for the export it is
# pinning.
module(name = "candace_archive_override_consumer")

bazel_dep(name = "candace", version = "0.0.0")
bazel_dep(name = "gazelle", version = "0.52.2")
bazel_dep(name = "rules_go", version = "0.62.0")

archive_override(
    module_name = "candace",
    integrity = "@CANDACE_ARCHIVE_INTEGRITY@",
    strip_prefix = "@CANDACE_ARCHIVE_PREFIX@",
    urls = ["@CANDACE_ARCHIVE_URL@"],
)

# This repository has no go.mod of its own — it is a Bazel-only consumer — so
# its direct Go dependencies are read out of candace's, which already pins every
# one of them at a version candace itself is tested with.
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "@candace//:go.mod")
use_repo(
    go_deps,
    "com_github_onsi_ginkgo_v2",
    "com_github_onsi_gomega",
    "org_golang_google_protobuf",
    "org_uber_go_mock",
)
